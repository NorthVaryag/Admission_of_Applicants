<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Admission_of_Applicants.ViewModels"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:DataType="vm:MyWindowViewModel"
        x:Class="Admission_of_Applicants.Views.MyWindow"
        Title="О приложении">

    <Grid ColumnDefinitions="* Auto Auto *"
          RowDefinitions="* Auto Auto *">
        <StackPanel VerticalAlignment="Center"
                    Grid.Row="1"
                    Grid.Column="1"
                    Grid.ColumnSpan="2">
            <TextBlock>Эта программа была сделана студентом  КГА ПОУ. "ППК":</TextBlock>
            <TextBlock>Климуком Олегом Валерьевичем в качестве курсовой работы</TextBlock>
            <TextBlock HorizontalAlignment="Center" Foreground="Red" FontWeight="Bold" FontSize="16">"не для коммерческого использования"</TextBlock>
        </StackPanel>
        <Button Command="{Binding OpenTelegramCommand}"
                Margin="10"
                Background="#34495E"
                CornerRadius="12"
                HorizontalAlignment="Left"
                Grid.Column="1" Grid.Row="2"
                Width="180" Height="180"
                VerticalAlignment="Stretch">
            <Button.Styles>
                <Style Selector="Button:pointerover /template/ ContentPresenter">
                    <Setter Property="Background" Value="#2980B9" />
                </Style>
            </Button.Styles>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <Path Width="45" Height="45" Fill="White" Stretch="Uniform"
                      Data="M12,2C6.48,2 2,6.48 2,12C2,17.52 6.48,22 12,22C17.52,22 22,17.52 22,12C22,6.48 17.52,2 12,2M16.64,8.8C16.44,10.9 15.6,15.86 15.17,18.15C14.9,19.4 14.3,19.4 13.92,19.33C13.06,19.26 12.4,18.62 11.57,18.08C10.27,17.23 9.54,16.7 8.28,15.87C6.82,14.91 7.76,14.38 8.6,13.5C8.82,13.27 12.6,9.83 12.67,9.5C12.68,9.46 12.69,9.32 12.61,9.25C12.52,9.18 12.4,9.2 12.31,9.22C12.18,9.25 10.15,10.6 6.2,13.27C5.62,13.67 5.1,13.86 4.63,13.85C4.12,13.84 3.12,13.56 2.38,13.32C1.47,13.03 0.75,12.87 0.81,12.37C0.84,12.11 1.2,11.84 1.89,11.56C6.14,9.71 8.98,8.48 10.42,7.88C14.5,6.19 15.36,5.89 15.92,5.89C16.04,5.89 16.32,5.92 16.5,6.07C16.66,6.2 16.7,6.38 16.72,6.5C16.74,6.63 16.77,6.92 16.75,7.12C16.54,9.2 16.64,8.8 16.64,8.8Z" />
                <TextBlock Text="Telegram" HorizontalAlignment="Center" Margin="0,8,0,0" Foreground="White"
                           FontSize="14" />
            </StackPanel>
        </Button>

        <Button Command="{Binding OpenGithubCommand}"
                Margin="10"
                Background="#34495E"
                CornerRadius="12"
                HorizontalAlignment="Right"
                Grid.Column="2" Grid.Row="2"
                Width="180" Height="180"
                VerticalAlignment="Stretch">
            <Button.Styles>
                <Style Selector="Button:pointerover /template/ ContentPresenter">
                    <Setter Property="Background" Value="#111418" />
                </Style>
            </Button.Styles>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <Path Width="45" Height="45" Fill="White" Stretch="Uniform"
                      Data="M12,2A10,10 0 0,0 2,12C2,16.42 4.87,20.17 8.84,21.5C9.34,21.58 9.5,21.27 9.5,21.03C9.5,20.81 9.5,20.24 9.5,19.46C6.73,20.06 6.14,18.12 6.14,18.12C5.69,16.97 5.04,16.67 5.04,16.67C4.14,16.06 5.11,16.07 5.11,16.07C6.11,16.14 6.63,17.1 6.63,17.1C7.5,18.61 8.94,18.17 9.5,17.93C9.6,17.31 9.85,16.89 10.12,16.65C7.9,16.4 5.56,15.54 5.56,11.71C5.56,10.61 5.95,9.72 6.59,9.03C6.49,8.77 6.14,7.75 6.69,6.37C6.69,6.37 7.53,6.1 9.44,7.39C10.24,7.17 11.09,7.06 11.94,7.06C12.79,7.06 13.64,7.17 14.44,7.39C16.35,6.1 17.19,6.37 17.19,6.37C17.74,7.75 17.39,8.77 17.29,9.03C17.93,9.72 18.32,10.61 18.32,11.71C18.32,15.55 15.98,16.39 13.75,16.64C14.11,16.95 14.43,17.57 14.43,18.52C14.43,19.88 14.42,20.98 14.42,21.31C14.42,21.58 14.6,21.89 15.1,21.8C19.08,20.46 22,16.63 22,12A10,10 0 0,0 12,2Z" />
                <TextBlock Text="GitHub" HorizontalAlignment="Center" Margin="0,8,0,0" Foreground="White" FontSize="14" />
            </StackPanel>
        </Button>
    </Grid>
</Window>