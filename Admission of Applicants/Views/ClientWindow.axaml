<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:Admission_of_Applicants.ViewModels"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Admission_of_Applicants.Views.ClientWindow"
        x:DataType="viewModels:ClientViewModel"
        Title="ClientWindow">
        
        <SplitView
                IsPaneOpen="{Binding IsPaneOpen}"
                   DisplayMode="CompactInline"
                   OpenPaneLength="300"
                   CompactPaneLength="53"
                   PaneBackground="MidnightBlue">
                
                <SplitView.Pane>
                        <StackPanel Background="#2C3E50" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                                <Button Background="Transparent" 
                                                Foreground="White"
                                                FontSize="16"
                                                Command="{Binding TogglePaneCommand}" 
                                                Content="☰" 
                                                Margin="10,10,10,20"
                                                HorizontalAlignment="Left">
                                        
                                </Button>
        
                                <Button Background="Transparent" 
                                        Foreground="#BDC3C7"
                                        Command="{Binding MainWindowStartCommand}"
                                        Height="40"
                                        Margin="5,2"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        VerticalContentAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Margin="10,0">
                                                <TextBlock Text="💻 " Margin="0,0,10,0"/>
                                                <TextBlock Text="Устройства"/>
                                        </StackPanel>
                                </Button>

                                <Button Background="Transparent" 
                                        Foreground="#BDC3C7"
                                        Command="{Binding EmployeesWindowStartCommand}"
                                        Height="40"
                                        Margin="5,2"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        VerticalContentAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Margin="10,0">
                                                <TextBlock Text="👥 " Margin="0,0,10,0"/>
                                                <TextBlock Text="Сотрудники"/>
                                        </StackPanel>
                                </Button>

                                <Button Background="Transparent" 
                                        Foreground="#BDC3C7"
                                        Command="{Binding TariffWindowStartCommand}"
                                        Height="40"
                                        Margin="5,2"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        VerticalContentAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Margin="10,0">
                                                <TextBlock Text="💳 " Margin="0,0,10,0"/>
                                                <TextBlock Text="Тарифы"/>
                                        </StackPanel>
                                </Button>
                                <Button Background="#16A085" 
                                        Foreground="White"
                                        Height="40"
                                        Margin="5,2"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        VerticalContentAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Margin="10,0">
                                                <TextBlock Text="🤝 " Margin="0,0,10,0"/>
                                                <TextBlock Text="Клиенты"/>
                                        </StackPanel>
                                </Button>
                        </StackPanel>
                </SplitView.Pane>

                
                <SplitView.Content>
                        <DataGrid ItemsSource="{Binding Clients}"
                                  IsReadOnly="True"
                                  CanUserReorderColumns="True"
                                  CanUserResizeColumns="True"
                                  CanUserSortColumns="True"
                                  GridLinesVisibility="All"
                                  AutoGenerateColumns="False"
                                  BorderThickness="1" BorderBrush="Gray">
                                <DataGrid.Columns>
                                        <DataGridTextColumn Header="Тип клиента"  Binding="{Binding NameType}"/>
                                        <DataGridTextColumn Header="Название организации, клиента"  Binding="{Binding DisplayName}"/>
                                        <DataGridTextColumn Header="Название тарифа"  Binding="{Binding TariffName}"/>
                                        <DataGridTextColumn Header="цена в месяц"  Binding="{Binding MonthlyPayment}"/>
                                </DataGrid.Columns>
                        </DataGrid>
                </SplitView.Content>
        </SplitView>
</Window>
